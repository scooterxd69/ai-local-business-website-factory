# AI Local Business Website Factory — environment variables
#
# Copy to .env and fill in. NEVER commit .env.
#
# Milestone 1 (renderer + samples) does not require any of these.
# Milestone 2 (Salon + Coaching variants) does not require them either.
# Milestone 3 (AI generation) will use AI_PROVIDER + the matching key.

# AI provider identifier. One of: "anthropic" | "openai" | "mock"
# Default: mock (returns deterministic sample specs; safe for local dev).
AI_PROVIDER=mock

# Used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# HTTP request timeout (ms) for AI calls
AI_TIMEOUT_MS=30000

# Published-site base URL (subdomain host for MVP)
PUBLIC_BASE_URL=http://localhost:3000
